diff --git a/libheif/api/libheif/heif_tiling.cc b/libheif/api/libheif/heif_tiling.cc
index 0e78443a..d162b5bc 100644
--- a/libheif/api/libheif/heif_tiling.cc
+++ b/libheif/api/libheif/heif_tiling.cc
@@ -271,3 +271,21 @@ struct heif_error heif_context_add_image_tile(struct heif_context* ctx,
     };
   }
 }
+
+heif_error heif_context_add_encoded_image_tile(struct heif_context* ctx,
+                                       struct heif_image_handle* tiled_image,
+                                       uint32_t tile_x, uint32_t tile_y,
+                                       uint8_t* data, uint32_t length)
+{
+  if (auto grid_item = std::dynamic_pointer_cast<ImageItem_Grid>(tiled_image->image)) {
+    Error err = grid_item->add_encoded_image_tile(tile_x, tile_y, heif_compression_HEVC, data, length);
+    return err.error_struct(ctx->context.get());
+  }
+  else {
+    return {
+        heif_error_Usage_error,
+        heif_suberror_Unspecified,
+        "Cannot add tile to a non-tiled image"
+    };
+  }
+}
