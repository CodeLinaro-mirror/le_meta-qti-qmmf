diff --git a/libheif/context.cc b/libheif/context.cc
index cb5b7813..7a4f24cf 100644
--- a/libheif/context.cc
+++ b/libheif/context.cc
@@ -1415,6 +1415,64 @@ Result<std::shared_ptr<ImageItem>> HeifContext::encode_image(const std::shared_p
   return output_image_item;
 }
 
+Result<std::shared_ptr<ImageItem>> HeifContext::encoded_image(
+                                heif_compression_format format,
+                                uint32_t width, uint32_t height,
+                                const std::vector<uint8_t>& bitstream)
+{
+ ImageItem_HEVC *hevc_image_item = NULL;
+
+  if (format == heif_compression_HEVC) {
+    hevc_image_item = new ImageItem_HEVC(this);
+  } else {
+    return Error{
+        heif_error_Invalid_input,
+        heif_suberror_Invalid_parameter_value,
+        "For now only hevc compression is supported."
+    };
+  }
+
+  hevc_image_item->set_size(width, height);
+
+  auto infe_box = get_heif_file()->add_new_infe_box(hevc_image_item->get_infe_type());
+  heif_item_id image_id = infe_box->get_item_ID();
+  hevc_image_item->set_id(image_id);
+
+  hevc_image_item->set_preencoded_hevc_image (bitstream);
+
+  std::vector<std::shared_ptr<Box>> mproperties;
+  auto ispe = std::make_shared<Box_ispe>();
+  ispe->set_size(width, height);
+  ispe->set_is_essential(hevc_image_item->is_ispe_essential());
+  mproperties.push_back(ispe);
+
+  std::shared_ptr<Box_pixi> pixi = std::make_shared<Box_pixi>();
+  pixi->add_channel_bits(8);
+  pixi->add_channel_bits(8);
+  pixi->add_channel_bits(8);
+  mproperties.push_back(pixi);
+
+   // set item properties
+  for (auto& propertyBox : mproperties) {
+    bool essential = propertyBox->is_essential();
+
+    int index = m_heif_file->get_ipco_box()->find_or_append_child_box(propertyBox);
+    m_heif_file->get_ipma_box()->add_property_for_item_ID(image_id, Box_ipma::PropertyAssociation{essential,
+                                                                                                           uint16_t(index + 1)});
+  }
+  std::shared_ptr<ImageItem> output_image_item = std::shared_ptr<ImageItem>(hevc_image_item);
+
+  insert_image_item(output_image_item->get_id(), output_image_item);
+
+  std::vector<std::shared_ptr<Box>> properties;
+  Error err = m_heif_file->get_properties(output_image_item->get_id(), properties);
+  if (err) {
+    return err;
+  }
+  output_image_item->set_properties(properties);
+
+  return output_image_item;
+}
 
