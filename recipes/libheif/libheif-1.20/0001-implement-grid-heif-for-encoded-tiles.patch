diff --git a/libheif/image-items/grid.cc b/libheif/image-items/grid.cc
index 24ece569..39df8fbd 100644
--- a/libheif/image-items/grid.cc
+++ b/libheif/image-items/grid.cc
@@ -708,6 +708,53 @@ Error ImageItem_Grid::add_image_tile(uint32_t tile_x, uint32_t tile_y,
   return Error::Ok;
 }
 
+Error ImageItem_Grid::add_encoded_image_tile(uint32_t tile_x, uint32_t tile_y,
+                                     heif_compression_format format,
+                                     uint8_t* data, uint32_t length)
+{
+  std::vector<unsigned char> bitstreams(data, data + length);
+  heif_image_tiling tiling = get_heif_image_tiling();
+
+  // If no tile avaiable, use default tile width/height.
+  if (tiling.tile_width == 0) {
+    tiling.tile_width = 512;
+  }
+
+  if (tiling.tile_height == 0) {
+    tiling.tile_height = 512;
+  }
+
+  auto encodingResult = get_context()->encoded_image(format,
+      tiling.tile_width, tiling.tile_height, bitstreams);
+  if (encodingResult.error) {
+    return encodingResult.error;
+  }
+
+  std::shared_ptr<ImageItem> encoded_image = *encodingResult;
+
+  auto file = get_file();
+  heif_item_id iid = encoded_image->get_id();
+  std::shared_ptr<Box_infe> infebox = file->get_infe_box(iid);
+
+  if (infebox == nullptr) {
+    printf ("null infebox\n");
+  } else {
+    infebox->set_hidden_item(true);
+  }
+
+  // grid tiles are hidden items
+  file->get_infe_box(encoded_image->get_id())->set_hidden_item(true);
+
+  // Assign tile to grid
+  file->set_iref_reference(get_id(), fourcc("dimg"), tile_y * tiling.num_columns + tile_x, encoded_image->get_id());
+  set_grid_tile_id(tile_x, tile_y, encoded_image->get_id());
+
+  // Add PIXI property (copy from first tile)
+  auto pixi = encoded_image->get_property<Box_pixi>();
+  add_property(pixi, true);
+
+  return Error::Ok;
+}
 
 Result<std::shared_ptr<ImageItem_Grid>> ImageItem_Grid::add_and_encode_full_grid(HeifContext* ctx,
