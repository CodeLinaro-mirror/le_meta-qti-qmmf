index c32d3ecb..c28aebe3 100644
--- a/libheif/api/libheif/heif_aux_images.cc
+++ b/libheif/api/libheif/heif_aux_images.cc
@@ -25,7 +25,7 @@
 #include <cstring>
 #include <memory>
 #include <algorithm>
-
+#include <vector>
 
 // ------------------------- depth images -------------------------
 
@@ -228,6 +228,37 @@ struct heif_error heif_context_encode_thumbnail(struct heif_context* ctx,
   return heif_error_success;
 }
 
+heif_error heif_context_encoded_thumbnail(heif_context* ctx,
+                                         const heif_image_handle* image_handle,
+                                         uint32_t format,
+                                         uint32_t width, uint32_t height,
+                                         uint8_t* data, uint32_t length)
+{
+  std::vector<unsigned char> bitstream(data, data + length);
+  auto encodingResult = ctx->context->encoded_image(heif_compression_HEVC,
+                                                  width, height,
+                                                  bitstream);
+
+  if (encodingResult.error != Error::Ok) {
+    return encodingResult.error.error_struct(ctx->context.get());
+  }
+
+  std::shared_ptr<ImageItem> thumbnail_image = *encodingResult;
+
+  if (!thumbnail_image) {
+    Error err(heif_error_Usage_error,
+              heif_suberror_Invalid_parameter_value,
+              "Thumbnail images must be smaller than the original image.");
+    return err.error_struct(ctx->context.get());
+  }
+
+  Error error = ctx->context->assign_thumbnail(image_handle->image, thumbnail_image);
+  if (error != Error::Ok) {
+    return error.error_struct(ctx->context.get());
+  }
+
+  return heif_error_success;
+}
 
